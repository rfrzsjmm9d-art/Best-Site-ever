<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Infinite Flow - The Ultimate Time Pass</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #050508;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
        }

        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .ui-container {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            text-align: center;
            pointer-events: none;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 300;
            letter-spacing: 4px;
            opacity: 0.8;
            text-shadow: 0 0 10px rgba(255,255,255,0.3);
        }

        .stats {
            margin-top: 8px;
            font-size: 0.9rem;
            opacity: 0.5;
            letter-spacing: 2px;
        }

        .controls {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            display: flex;
            gap: 15px;
            background: rgba(255, 255, 255, 0.05);
            padding: 10px 20px;
            border-radius: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        button {
            background: transparent;
            border: none;
            color: #fff;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.85rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        button:hover {
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body>

    <div class="ui-container">
        <h1>INFINITE FLOW</h1>
        <div class="stats">Energie gesammelt: <span id="score">0</span></div>
    </div>

    <div class="controls">
        <button id="btnSound">🔊 Sound: AUS</button>
        <button id="btnReset">✨ Particle Wave</button>
    </div>

    <canvas id="canvas"></canvas>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');

        let width, height;
        let particles = [];
        let targets = [];
        let score = 0;
        let audioCtx = null;
        let soundEnabled = false;

        const MOUSE = {
            x: null,
            y: null,
            radius: 150
        };

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resize);
        resize();

        window.addEventListener('mousemove', (e) => {
            MOUSE.x = e.x;
            MOUSE.y = e.y;
            if (soundEnabled && Math.random() < 0.1) playTone(e.y);
        });

        window.addEventListener('click', (e) => {
            createExplosion(e.x, e.y);
            if (soundEnabled) playTone(e.y, 440, 'triangle');
        });

        class Particle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 2 + 1;
                this.baseX = this.x;
                this.baseY = this.y;
                this.vx = (Math.random() - 0.5) * 1;
                this.vy = (Math.random() - 0.5) * 1;
                this.color = `hsl(${Math.random() * 60 + 180}, 80%, 60%)`;
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.fill();
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < 0 || this.x > width) this.vx *= -1;
                if (this.y < 0 || this.y > height) this.vy *= -1;

                // Maus-Interaktion
                if (MOUSE.x !== null) {
                    let dx = MOUSE.x - this.x;
                    let dy = MOUSE.y - this.y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < MOUSE.radius) {
                        let force = (MOUSE.radius - distance) / MOUSE.radius;
                        let angle = Math.atan2(dy, dx);
                        this.x -= Math.cos(angle) * force * 5;
                        this.y -= Math.sin(angle) * force * 5;
                    }
                }
            }
        }

        class EnergyOrb {
            constructor() {
                this.x = Math.random() * (width - 100) + 50;
                this.y = Math.random() * (height - 100) + 50;
                this.radius = 8;
                this.pulse = 0;
            }

            draw() {
                this.pulse += 0.05;
                let currentRadius = this.radius + Math.sin(this.pulse) * 3;

                ctx.beginPath();
                ctx.arc(this.x, this.y, currentRadius, 0, Math.PI * 2);
                ctx.fillStyle = '#fff';
                ctx.shadowBlur = 20;
                ctx.shadowColor = '#00ffff';
                ctx.fill();
            }

            checkHit() {
                if (MOUSE.x !== null) {
                    let dx = MOUSE.x - this.x;
                    let dy = MOUSE.y - this.y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < 30) {
                        score += 10;
                        scoreEl.innerText = score;
                        createExplosion(this.x, this.y, 30);
                        if (soundEnabled) playTone(600, 880, 'sine');
                        this.x = Math.random() * (width - 100) + 50;
                        this.y = Math.random() * (height - 100) + 50;
                    }
                }
            }
        }

        function init() {
            particles = [];
            targets = [];
            for (let i = 0; i < 200; i++) {
                particles.push(new Particle());
            }
            for (let i = 0; i < 3; i++) {
                targets.push(new EnergyOrb());
            }
        }

        function createExplosion(x, y, count = 15) {
            for (let i = 0; i < count; i++) {
                let p = new Particle();
                p.x = x;
                p.y = y;
                let angle = Math.random() * Math.PI * 2;
                let speed = Math.random() * 6 + 2;
                p.vx = Math.cos(angle) * speed;
                p.vy = Math.sin(angle) * speed;
                particles.push(p);
            }
            if (particles.length > 350) {
                particles.splice(0, count);
            }
        }

        function animate() {
            ctx.fillStyle = 'rgba(5, 5, 8, 0.2)';
            ctx.fillRect(0, 0, width, height);

            particles.forEach(p => {
                p.update();
                p.draw();
            });

            targets.forEach(t => {
                t.draw();
                t.checkHit();
            });

            requestAnimationFrame(animate);
        }

        // Web Audio API für prozedurale Entspannungssounds
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playTone(freqInput, customFreq, type = 'sine') {
            if (!audioCtx) return;
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();

            let freq = customFreq || (100 + (1 - freqInput / height) * 500);
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

            gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.8);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + 0.8);
        }

        // Event-Listener für UI Buttons
        document.getElementById('btnSound').addEventListener('click', (e) => {
            initAudio();
            soundEnabled = !soundEnabled;
            e.target.innerText = soundEnabled ? '🔊 Sound: AN' : '🔇 Sound: AUS';
        });

        document.getElementById('btnReset').addEventListener('click', () => {
            createExplosion(width / 2, height / 2, 50);
        });

        init();
        animate();
    </script>
</body>
</html>
